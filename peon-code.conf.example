# peon-code team: one agent per line, "name command... role".
# The role is the last token and is required; use - for no role.
# A bare role name reads roles/<name>.md next to peon-code.sh;
# a role token with a / is a file path, relative to this config file.
# Full-line # comments and blank lines are skipped. No inline comments.
# A leading * on a name marks the main agent: its pane gets the big left
# slot. Without a mark, the first manager is main, else the first agent.

# name   command                                                     role
*boss    claude --model claude-fable-5 --effort high                 manager
archie   claude --model claude-opus-5 --effort medium                reviewer
impl     codex --model gpt-5.6-luna -c model_reasoning_effort=max    implementer
scout    codex --model gpt-5.6-sol -c model_reasoning_effort=medium  explorer
